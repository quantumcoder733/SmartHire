 "cells": [
  {
   "cell_type": "markdown",
   "id": "3675b137",
   "metadata": {},
   "source": [
    "# Historical Recommender Prototype\n",
    "\n",
    "This notebook demonstrates an earlier in-memory TF-IDF recommender and broad-field skill comparison. It calls `load_jobs()` and fits a job index when run; it is not the Streamlit runtime workflow, which uses persisted artifacts. Running the indexing cells can process the full prepared job corpus."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "721d2658",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import sys\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "project_root = Path.cwd().parent\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "from src.data.load_data import load_jobs\n",
    "\n",
    "jobs_df = load_jobs()\n",
    "print(\"Loaded jobs:\", jobs_df.shape)\n",
    "jobs_df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e88c5a71",
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.models.recommender import build_job_index, recommend_jobs\n",
    "from src.models.skill_gap import calculate_skill_gap"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "60f41c20",
   "metadata": {},
   "outputs": [],
   "source": [
    "vectorizer, job_matrix = build_job_index(jobs_df)\n",
    "\n",
    "print(\"Job matrix shape:\", job_matrix.shape)\n",
    "print(\"Number of TF-IDF features:\", len(vectorizer.get_feature_names_out()))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e112a0a2",
   "metadata": {},
   "outputs": [],
   "source": [
    "candidate_resume = \"\"\"\n",
    "Python developer with experience in machine learning,\n",
    "Pandas, NumPy, SQL and data analysis.\n",
    "Worked on machine learning projects using Scikit-learn.\n",
    "\"\"\"\n",
    "\n",
    "recommendations = recommend_jobs(\n",
    "    candidate_resume,\n",
    "    jobs_df,\n",
    "    vectorizer,\n",
    "    job_matrix,\n",
    "    top_n=5,\n",
    ")\n",
    "\n",
    "recommendations_df = pd.DataFrame(recommendations)\n",
    "recommendations_df[\n",
    "    [\"rank\", \"title\", \"company\", \"location\", \"experience\", \"similarity_score\"]\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "be1c3b54",
   "metadata": {},
   "outputs": [],
   "source": [
    "candidate_text = candidate_resume.casefold()\n",
    "\n",
    "for recommendation in recommendations:\n",
    "    job_skills = {\n",
    "        skill.strip().casefold()\n",
    "        for skill in str(recommendation.get(\"skills\", \"\")).split(\",\")\n",
    "        if skill.strip()\n",
    "    }\n",
    "    candidate_skills = {\n",
    "        skill for skill in job_skills if skill in candidate_text\n",
    "    }\n",
    "    skill_gap = calculate_skill_gap(candidate_skills, job_skills)\n",
    "    recommendation[\"matched_skills\"] = skill_gap[\"matched_skills\"]\n",
    "    recommendation[\"missing_skills\"] = skill_gap[\"missing_skills\"]\n",
    "\n",
    "recommendations_df = pd.DataFrame(recommendations)\n",
    "recommendations_df[\n",
    "    [\n",
    "        \"rank\",\n",
    "        \"title\",\n",
    "        \"company\",\n",
    "        \"location\",\n",
    "        \"experience\",\n",
    "        \"similarity_score\",\n",
    "        \"matched_skills\",\n",
    "        \"missing_skills\",\n",
    "    ]\n",
    "]"
   ]
  }
 ],
