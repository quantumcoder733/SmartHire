   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4f4bf4bb",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv(\"../data/raw/UpdatedResumeDataSet.csv\")\n",
    "\n",
    "df[[\"Category\"]].head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "57e07a5f",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Shape:\", df.shape)\n",
    "print(\"\\nColumns:\")\n",
    "print(df.columns.tolist())\n",
    "\n",
    "print(\"\\nData types:\")\n",
    "print(df.dtypes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1be3e8ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "category_counts = df[\"Category\"].value_counts()\n",
    "\n",
    "print(category_counts)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d4951d42",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(12, 8))\n",
    "\n",
    "sns.countplot(\n",
    "    data=df,\n",
    "    y=\"Category\",\n",
    "    order=df[\"Category\"].value_counts().index\n",
    ")\n",
    "\n",
    "plt.title(\"Resume Count by Job Category\")\n",
    "plt.xlabel(\"Number of Resumes\")\n",
    "plt.ylabel(\"Job Category\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "805a51c2",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"resume_length\"] = df[\"Resume\"].str.len()\n",
    "\n",
    "df[\"resume_length\"].describe()\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "sns.histplot(\n",
    "    data=df,\n",
    "    x=\"resume_length\",\n",
    "    bins=30,\n",
    "    kde=True\n",
    ")\n",
    "\n",
    "plt.title(\"Distribution of Resume Lengths\")\n",
    "plt.xlabel(\"Resume Length (Characters)\")\n",
    "plt.ylabel(\"Number of Resumes\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b16e0425",
   "metadata": {},
   "outputs": [],
   "source": [
    "duplicate_mask = df[\"Resume\"].duplicated(keep=False)\n",
    "\n",
    "duplicate_by_category = (\n",
    "    df[duplicate_mask][\"Category\"]\n",
    "    .value_counts()\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "duplicate_by_category"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "78ae1a15",
   "metadata": {},
   "outputs": [],
   "source": [
    "unique_by_category = (\n",
    "    df.groupby(\"Category\")[\"Resume\"]\n",
    "    .nunique()\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "unique_by_category\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "13ea6bfc",
   "metadata": {},
   "outputs": [],
   "source": [
    "X = df[\"Resume\"]\n",
    "y = df[\"Category\"]\n",
    "\n",
    "print(\"X shape:\", X.shape)\n",
    "print(\"y shape:\", y.shape)\n",
    "print(\"Resume text preview omitted to protect personal data.\")\n",
    "\n",
    "print(\"\\nFirst label:\")\n",
    "print(y.iloc[0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "81a20129",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    random_state=42,\n",
    "    stratify=y\n",
    ")\n",
    "\n",
    "print(\"Training samples:\", len(X_train))\n",
    "print(\"Testing samples:\", len(X_test))\n",
    "\n",
    "print(\"\\nTraining categories:\", y_train.nunique())\n",
    "print(\"Testing categories:\", y_test.nunique())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2fdb9d02",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "\n",
    "tfidf = TfidfVectorizer(\n",
    "    max_features=5000,\n",
    "    stop_words=\"english\"\n",
    ")\n",
    "\n",
    "X_train_tfidf = tfidf.fit_transform(X_train)\n",
    "X_test_tfidf = tfidf.transform(X_test)\n",
    "\n",
    "print(\"Training TF-IDF shape:\", X_train_tfidf.shape)\n",
    "print(\"Testing TF-IDF shape:\", X_test_tfidf.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d83488d2",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "classifier = LogisticRegression(\n",
    "    max_iter=1000,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "classifier.fit(X_train_tfidf, y_train)\n",
    "\n",
    "print(\"Model training completed!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6d7eeecd",
   "metadata": {},
   "outputs": [],
   "source": [
    "y_pred = classifier.predict(X_test_tfidf)\n",
    "\n",
    "print(\"Predictions generated:\", len(y_pred))\n",
    "\n",
    "print(\"\\nFirst 10 predictions:\")\n",
    "print(y_pred[:10])\n",
    "\n",
    "print(\"\\nFirst 10 actual labels:\")\n",
    "print(y_test.iloc[:10].values)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0be312a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import accuracy_score\n",
    "\n",
    "accuracy = accuracy_score(y_test, y_pred)\n",
    "\n",
    "print(f\"Accuracy: {accuracy:.4f}\")\n",
    "print(f\"Accuracy: {accuracy * 100:.2f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "941844c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import classification_report\n",
    "\n",
    "report = classification_report(\n",
    "    y_test,\n",
    "    y_pred,\n",
    "    zero_division=0\n",
    ")\n",
    "\n",
    "print(report)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "704a0968",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import ConfusionMatrixDisplay\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 14))\n",
    "\n",
    "ConfusionMatrixDisplay.from_predictions(\n",
    "    y_test,\n",
    "    y_pred,\n",
    "    xticks_rotation=90,\n",
    "    ax=ax\n",
    ")\n",
    "\n",
    "plt.title(\"Resume Category Classifier - Confusion Matrix\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5b2934f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import sys\n",
    "\n",
    "project_root = Path.cwd().parent\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "print(\"Project root:\", project_root)\n",
    "\n",
    "from src.models.classifier import train_classifier, predict_categories\n",
    "model = train_classifier(X_train, y_train)\n",
    "\n",
    "y_pred_module = predict_categories(model, X_test)\n",
    "\n",
    "print(\"Predictions generated:\", len(y_pred_module))\n",
    "\n",
    "print(\"\\nFirst 10 predictions:\")\n",
    "print(y_pred_module[:10])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "58b0018e",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import accuracy_score\n",
    "\n",
    "module_accuracy = accuracy_score(y_test, y_pred_module)\n",
    "\n",
    "print(f\"Module accuracy: {module_accuracy:.4f}\")\n",
    "print(f\"Module accuracy: {module_accuracy * 100:.2f}%\")\n"
   ]
  }
 ],
