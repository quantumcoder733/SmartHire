# Python environments, bytecode, test and notebook caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# IDE and local configuration
.vscode/
.idea/
.env
.env.*
*.env
.streamlit/secrets.toml

# Logs and temporary files
*.log
*.tmp
.DS_Store
Thumbs.db

# Resume uploads and generated documents can contain personal information
*.pdf
data/resume1.pdf
*test*resume*

# Source datasets and prepared corpora are intentionally kept outside Git.
# See data/DATASETS.md for provenance and preparation notes.
data/raw/
data/interim/
data/processed/

# Reproducible large job-index artifacts are excluded from normal Git.
# Generate these offline from data/processed/jobs_clean.csv; see README.md.
models/*.npz
models/*.csv
models/*.pkl
models/*.joblib
models/job_tfidf.npz
models/job_metadata.csv

# Keep small runtime model artifacts eligible for intentional tracking.
# They are generated by the offline commands documented in README.md.
!models/resume_classifier.pkl
!models/job_vectorizer.pkl
!models/job_kmeans.pkl
!models/job_clusters.csv
